FIGMA_TOKEN=your-personal-access-token
FIGMA_FILE_ID=your-figma-file-id
# Optional: comma-separated extension collections to opt in to, e.g. "DN WEB" or "* WEB"
INCLUDED_COLLECTIONS=
# Optional: where to write output (default: example/output/tokens and example/output/json).
# Relative paths resolve against the current directory; "~" expands to your home directory.
TOKENS_OUTPUT_PATH=
JSON_OUTPUT_PATH=
